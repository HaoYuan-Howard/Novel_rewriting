],"span_coverage":[9,9],"beats":8,"hidden":6},{"output_ordinal":4,"op":"keep","span_chars":1154,"budget_chars":1050,"in_band":true,"style_hits":[],"span_coverage":[7,7],"beats":5,"hidden":4},{"output_ordinal":5,"op":"keep","span_chars":1321,"budget_chars":1280,"in_band":true,"style_hits":[],"span_coverage":[10,10],"beats":9,"hidden":2},{"output_ordinal":6,"op":"keep","span_chars":1217,"budget_chars":1140,"in_band":true,"style_hits":[],"span_coverage":[8,8],"beats":6,"hidden":0},{"output_ordinal":7,"op":"keep","span_chars":1551,"budget_chars":1500,"in_band":true,"style_hits":[],"span_coverage":[8,8],"beats":8,"hidden":0},{"output_ordinal":8,"op":"keep","span_chars":1165,"budget_chars":1120,"in_band":true,"style_hits":[],"span_coverage":[7,7],"beats":7,"hidden":0}],"ordinal":3,"chapter":{"output_ordinal":3,"from_source_ordinals":[3],"op":"keep","chapter_goal":"女主升任教习师，借杜婉儿刺激苏子瑜，并识破密谋，展现其将计就计的狠辣。","open_hook_goal":"以公爹下海、女主职级上升开场，突出局势变化。","end_hook_goal":"女主冷笑盘算让婆母顶替，埋下反击伏笔。","span_chars":1442,"span_coverage":[9,9],"band":[1297,1586],"budget_chars":1360,"in_band":true,"writer_target":[1224,1496],"writer_target_estimated":false,"chapter_source_chars":1461,"beats":[{"i":1,"from_beats":["b03_01"],"unknown_refs":[],"budget_chars":130,"source_chars":144,"verbatim_chars":0,"events":["公爹在我的大力举荐下也下海了，与夫君一同霸榜怡绿院贵客首选第一梯队。我的职级从杂役丫鬟升为钮钴禄·特聘教习师，每日钻研男德知识并向公爹和夫君传道授业解惑，收获苏家男人成吨的仇恨目光。"],"time_layer":"present","place":"怡红院","present":["李宝珠"],"segments":[],"verbatim":[],"keep_value":[],"must_appear":[],"must_hold":[]},{"i":2,"from_beats":["b03_02"],"unknown_refs":[],"budget_chars":140,"source_chars":154,"verbatim_chars":0,"events":["婆母偷偷来上房远远观望自己的夫君和爱子，眼看他们日渐阴柔、阳刚不再，整日以泪洗面，逢人便说遇见我这般儿媳是造孽，并当我的面怒骂我爹不保亲家，全然忘了公爹曾三番五次欲置我爹于死地。"],"time_layer":"present","place":"上房","present":["婆母","苏子瑜","苏照庭"],"segments":[],"verbatim":[],"keep_value":[],"must_appear":[],"must_hold":[]},{"i":3,"from_beats":["b03_03"],"unknown_refs":[],"budget_chars":130,"source_chars":143,"verbatim_chars":0,"events":["我的教习课堂上有侍卫巡场，我对夫君和公爹事必躬亲，梳妆课程总拿他们当榜样，衣食住行安排得妥帖，远比当初我在苏家做儿媳时的待遇好千倍百倍。我清楚夫君好才是真的好，我靠他过好日子。"],"time_layer":"present","place":"教习课堂","present":["李宝珠","苏子瑜","苏照庭"],"segments":[],"verbatim":[],"keep_value":[],"must_appear":[],"must_hold":["我心里门儿清：夫君好，才是真的好。","我还要靠我夫君过好日子呢。"]},{"i":4,"from_beats":["b03_04"],"unknown_refs":[],"budget_chars":160,"source_chars":177,"verbatim_chars":17,"events":["夫君被磋磨过度，整日萎靡不振，水灵大打折扣，我急得嘴上起了燎泡。我关心他身体，他却诅咒我早死，每日营业不情不愿全靠龟公上手段。我心急如焚，为讨好他，花银子托人寻来他的白月光青梅杜婉儿，希望给她一些精神鼓励。"],"time_layer":"present","place":"怡红院","present":["李宝珠","苏子瑜"],"segments":[],"verbatim":["李宝珠，你这阴损毒妇怎么还不死！”"],"keep_value":[],"must_appear":[],"must_hold":[]},{"i":5,"from_beats":["b03_05"],"unknown_refs":[],"budget_chars":280,"source_chars":374,"verbatim_chars":0,"events":["我向杜婉儿起誓称当初成婚夫君心里就没我、次日喜帕是我造假、他心里只有她一人，并说如今情形不久便能赎身，届时公婆不会反对。杜婉儿半信半疑，我解释称夫君为新婚夜逼死我，我当时不承认是为离间二人，如今请她劝慰夫君。杜婉儿认定是我从中作梗，我连连致歉，计划将她带进练功房。"],"time_layer":"present","place":"怡红院","present":["李宝珠","杜婉儿"],"segments":[],"verbatim":[],"keep_value":[],"must_appear":[],"must_hold":["次日喜帕是我造假。”"]},{"i":6,"from_beats":["b03_06"],"unknown_refs":[],"budget_chars":160,"source_chars":186,"verbatim_chars":6,"events":["往常午间苏子瑜在此练琴箫，不料今日行程有变无人知会。推门时我与杜婉儿撞见苏子瑜正在“挨打”，贵客怒骂一声滚，我火速带神色恍惚的杜婉儿离开。杜婉儿暴风哭泣，质问苏子瑜自甘下贱，怀疑是我安排并出卖夫君，随后捂着手帕跑走。"],"time_layer":"present","place":"练功房","present":["李宝珠","杜婉儿","苏子瑜","贵客"],"segments":[],"verbatim":["怒骂一声滚。"],"keep_value":[],"must_appear":[],"must_hold":["哪知他今日行程有了变动，竟无人知会我。"]},{"i":7,"from_beats":["b03_07","b03_08"],"unknown_refs":[],"budget_chars":200,"source_chars":144,"verbatim_chars":30,"events":["苏子瑜待客人走后与我吵闹，怪我让婉儿看到害他失去最后念想，威胁自己已是头牌不怕报复，豁出命也绝不饶我。我自觉理亏，丧眉耷眼地没话说。","苏子瑜找人替他与杜婉儿鸿雁传书，精神头竟一日赛过一日的好了起来。"],"time_layer":null,"place":null,"present":[],"segments":[{"time_layer":"present","place":"怡红院房间","present":["李宝珠","苏子瑜"]},{"time_layer":"present","place":"怡红院","present":[]}],"verbatim":["你就不怕我报复？”","“你给我等着！我豁出去这条命也绝不饶你！”"],"keep_value":[],"must_appear":[],"must_hold":[]},{"i":8,"from_beats":["b03_09"],"unknown_refs":[],"budget_chars":160,"source_chars":120,"verbatim_chars":0,"events":["龟公神神秘秘地把苏子瑜和杜婉儿的密信给我看，原来二人已同仇敌忾，计划让杜婉儿的弟弟杜玉闲来怡红院点名找我这个苏府女眷过夜。我看完冷笑，盘算让婆母顶替，因为苏府女眷不止我一个。"],"time_layer":"present","place":"怡红院","present":["李宝珠","龟公"],"segments":[],"verbatim":[],"keep_value":[],"must_appear":["密信"],"must_hold":[]}],"style_hits":[],"characters":{"char_001":{"display_name":"李宝珠","role":"李将军独女，新婚遭夫家磋磨，后利用怡红院环境报复苏家，最终成为怡红院主理人，并为国家刺探情报"},"char_002":{"display_name":"爹","role":"武将，李宝珠之父，与苏照庭是政敌，支持三皇子登基，后成为新朝重臣"},"char_003":{"display_name":"苏子瑜","role":"苏照庭独子，李宝珠夫君，后沦为怡红院头牌，勾结外族叛国"},"char_004":{"display_name":"苏照庭","role":"官员，与李将军政敌，苏子瑜之父，后贬入怡红院刷恭桶，又下海接客，勾结外族"},"char_005":{"display_name":"婆母","role":"苏照庭之妻，苏子瑜之母，后与杜玉闲有染并产子，脱离苏家"},"char_006":{"display_name":"杜婉儿","role":"苏子瑜的青梅竹马，后嫁给富商为妾"},"char_007":{"display_name":"杜玉闲","role":"杜婉儿之弟，赌徒，使苏夫人怀孕，后冷落她"},"char_008":{"display_name":"龟公","role":"表面是怡红院龟公，实乃百晓生，皇帝安插在怡红院的眼线，后成为李宝珠的副手"},"char_009":{"display_name":"嬷嬷","role":"怡红院管事嬷嬷，善于经营，管理青楼和绿院"},"char_010":{"display_name":"新帝","role":"皇帝，先为三皇子，与李将军结盟，登基后贬苏家，派谢允监控怡红院"},"char_011":{"display_name":"老皇帝","role":"先帝，赐婚李宝珠与苏子瑜"},"char_013":{"display_name":"贵客","role":"外族势力首领，与苏家父子勾结叛国"},"char_015":{"display_name":"暗卫","role":"李宝珠的暗卫，执行打晕苏子瑜和取血的任务"}},"facts":{"setting":{"时代背景":"古代架空王朝，存在皇帝赐婚、贱籍制度、青楼文化，有外族边境冲突。","世界观":"无奇幻元素，现实向古代世界，主角有暗卫、朝堂斗争、情报间谍等活动。"},"relations":[{"subject":"李宝珠","predicate":"是妻子","object":"苏子瑜"},{"subject":"苏子瑜","predicate":"与...是恋人","object":"杜婉儿"},{"subject":"苏照庭","predicate":"是丈夫","object":"婆母"},{"subject":"李宝珠","predicate":"是女儿","object":"爹"},{"subject":"苏子瑜","predicate":"是儿子","object":"苏照庭"},{"subject":"苏子瑜","predicate":"是儿子","object":"婆母"},{"subject":"杜婉儿","predicate":"是姐姐","object":"杜玉闲"},{"subject":"新帝","predicate":"是君主","object":"龟公"},{"subject":"李宝珠","predicate":"是儿媳","object":"苏照庭"},{"subject":"李宝珠","predicate":"是儿媳","object":"婆母"},{"subject":"李宝珠","predicate":"有暗卫","object":"暗卫"}],"secrets":[{"secret_id":"secret_01","fact":"苏子瑜与杜婉儿密谋，让杜玉闲到怡红院点李宝珠过夜，以污她清白，且苏夫人提供了秘药。","