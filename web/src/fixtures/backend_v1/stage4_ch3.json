  "beats": [
   {
    "events": [
     "公爹在我的大力举荐下也下海了，与夫君一同霸榜怡绿院贵客首选第一梯队。我的职级从杂役丫鬟升为钮钴禄·特聘教习师，每日钻研男德知识并向公爹和夫君传道授业解惑，收获苏家男人成吨的仇恨目光。"
    ],
    "budget_chars": 130,
    "source_chars": 144,
    "time_layer": "present",
    "place": "怡红院",
    "present": [
